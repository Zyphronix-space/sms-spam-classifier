# Vercel container build for the gateway: compiles the Ballerina service from
# source (no prebuilt jar needed) and runs it with the same entrypoint as the
# plain Dockerfile. Set BACKEND_URL, API_KEY and PORT=9000 on the Vercel project.
FROM ballerina/ballerina:2201.13.5 AS build
USER root
WORKDIR /src
COPY Ballerina.toml Dependencies.toml service.bal ./
RUN bal build

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /src/target/bin/gateway.jar gateway.jar
COPY entrypoint.sh entrypoint.sh
RUN sed -i 's/\r$//' entrypoint.sh && chmod +x entrypoint.sh
EXPOSE 9000
ENTRYPOINT ["./entrypoint.sh"]
