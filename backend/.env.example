# Copy to .env and fill in local values. Never commit the real .env file.

DATABASE_URL=postgresql://sms_classifier_app:CHANGE_ME@127.0.0.1:5432/sms_classifier
JWT_SECRET=change-this-to-a-long-random-string
# Set to true once served over HTTPS (production). Must stay false for
# local http://localhost development or the browser will drop the cookie.
COOKIE_SECURE=false
